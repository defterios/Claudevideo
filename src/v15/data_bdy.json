 "lines": [
  {
   "start": 0.5,
   "end": 8.47,
   "text": "Jesus meh pari motas orad, ogi ni dari biturak duoh nya rie ninga Jesus. Jairus, kitua bori synagogue.",
   "tempter": false
  },
  {
   "start": 8.77,
   "end": 13.67,
   "text": "Onak dayungku doras monam. Mitie masi duoh Ingan, odi toma gonan eh da yeh bait.",
   "tempter": false
  },
  {
   "start": 14.05,
   "end": 18.08,
   "text": "Jesus meh nuna yeh. Ju nya de kiang kiang inuh meh nuna geh dep eh duoh.",
   "tempter": false
  },
  {
   "start": 18.38,
   "end": 26.47,
   "text": "Daang ayuo nya de munu ogi dayung de obuoh onam bubu sapai meh 12 sowa. Puas yeh odi brubat, pak eh makin bitamah onam eh.",
   "tempter": false
  },
  {
   "start": 26.77,
   "end": 30.55,
   "text": "Komo ku meh daped kadu toma jubah Eh, mokuo onam ku neh.",
   "tempter": false
  },
  {
   "start": 30.83,
   "end": 36.45,
   "text": "Yeh pruah tongan eh, toma jubah Eh. Rasu danu geh, yeh meh sai onam eh meh doi.",
   "tempter": false
  },
  {
   "start": 37.25,
   "end": 39.15,
   "text": "Osi de toma jubah Ku?",
   "tempter": false
  },
  {
   "start": 39.75,
   "end": 45.16,
   "text": "Yeh meh kimotor tia, ju ju meh pubap de peen Jesus, dang eh tanen oni de nai eh.",
   "tempter": false
  },
  {
   "start": 45.56,
   "end": 50.52,
   "text": "Oo madis, mu meh bait sobab mu bisaya. Maad toban otin mu de sonang.",
   "tempter": false
  },
  {
   "start": 51.22,
   "end": 54.21,
   "text": "Onak ingan meh kobes. Dusah nya gaguo Mistar tia.",
   "tempter": false
  },
  {
   "start": 54.69,
   "end": 56.58,
   "text": "Ma toru. Bisaya negeh.",
   "tempter": false
  },
  {
   "start": 57.38,
   "end": 65.08,
   "text": "Takar de bori inuh, nyaa kiak kaung sien. Yeh meh nang: Yeh ideh di eh kobes, jek eh bees. Nya munu meh toweh yeh.",
   "tempter": false
  },
  {
   "start": 65.58,
   "end": 67.97,
   "text": "Yeh meh geng tongan onak dayung inuh, ju meh in Eh:",
   "tempter": false
  },
  {
   "start": 68.37,
   "end": 72.21,
   "text": "Talitha koum. Onak dayung, Oku da muu mokat.",
   "tempter": false
  },
  {
   "start": 73.21,
   "end": 77.3,
   "text": "Onak dayung inuh de 12 umur eh, meh rasu mokat ju meh ponu.",
   "tempter": false
  },
  {
   "start": 78.2,
   "end": 81.47,
   "text": "Nuna koih suo part 9.",
   "tempter": false
  }
 ]
}