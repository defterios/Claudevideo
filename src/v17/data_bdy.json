 "lines": [
  {
   "start": 0.5,
   "end": 4.48,
   "text": "Para Rasul meh pari ju meh tanon nudu Jesus suo kroja de meh nai nya munu.",
   "tempter": false
  },
  {
   "start": 4.88,
   "end": 9.7,
   "text": "Get nuna Oku ke topat de motug de doi nyaa dang eh, sa te daped re'e ni tirie.",
   "tempter": false
  },
  {
   "start": 10.1,
   "end": 15.96,
   "text": "Pak eh bogo nyaa kirin eh, jadi nyaa munu meh die ponu poon ke topat inuh. 5000 urang manusia.",
   "tempter": false
  },
  {
   "start": 16.36,
   "end": 23.31,
   "text": "Takar Jesus meh kirin nyaa kajen yeh, meh ruop nyam otin eh masi ninga nya munu. De meh koda koming de doi gembara eh.",
   "tempter": false
  },
  {
   "start": 23.81,
   "end": 26.94,
   "text": "Onu meh ramat. Da nya muti pari die karik pinguman.",
   "tempter": false
  },
  {
   "start": 27.25,
   "end": 29.11,
   "text": "Dop ingan ngin pinguman duoh eh.",
   "tempter": false
  },
  {
   "start": 29.51,
   "end": 32.41,
   "text": "Otto jek ogi 5 kruang ruti, 2 porong kien.",
   "tempter": false
  },
  {
   "start": 32.83,
   "end": 36.87,
   "text": "Yeh meh bigaeng ke rongit, ngin trima kasih de Topa, ju meh nyipiek ruti de munu.",
   "tempter": false
  },
  {
   "start": 37.47,
   "end": 46.14,
   "text": "Meh doi poted-poted tia pinguman. Suo nya daped geh man, meh sukup busuoh. Gi ogi geh 12 ade bakur de masih punuo da pinguman.",
   "tempter": false
  },
  {
   "start": 46.84,
   "end": 52.69,
   "text": "Ngaruom inuh, Jesus rasu da onak murid eh maad pakai orud, ju Yeh meh jikeh pungu sadi eh ngan Eh rie smayang.",
   "tempter": false
  },
  {
   "start": 53.19,
   "end": 56.77,
   "text": "Sobak ribut skia doras. Bijam jam nya munu bikayuh.",
   "tempter": false
  },
  {
   "start": 57.17,
   "end": 61.13,
   "text": "Ngaran pukul 3 sipagi, nya munu meh kirin sibamie ponu de tun piin.",
   "tempter": false
  },
  {
   "start": 61.43,
   "end": 62.81,
   "text": "Ai munuo tu inuh neh!",
   "tempter": false
  },
  {
   "start": 63.1,
   "end": 66.46,
   "text": "Ma naru dep ingan. Oku itih neh. Ma toru.",
   "tempter": false
  },
  {
   "start": 67.06,
   "end": 72.1,
   "text": "Jesus meh maad kang orud, ju sobak rasu re. Nya munu meh gogeh ninga Kiasa Eh.",
   "tempter": false
  },
  {
   "start": 73.0,
   "end": 76.33,
   "text": "Nuna koih suo part 11.",
   "tempter": false
  }
 ]
}