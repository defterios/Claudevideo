 "lines": [
  {
   "start": 2.2,
   "end": 7.0,
   "text": "Ngan Jesus meh nog ke sborang. Topat jier. Deng rate. Duoh deng nya ngrais.",
   "tempter": false
  },
  {
   "start": 7.5,
   "end": 10.86,
   "text": "Ogi dari de ree de jier inuh. Doi nya daped pasung eh tia.",
   "tempter": false
  },
  {
   "start": 11.26,
   "end": 15.73,
   "text": "Takar yeh meh kirin Jesus, yeh meh bikoduh nudu Eh, ju meh ngoruob de peen Jesus.",
   "tempter": false
  },
  {
   "start": 16.03,
   "end": 19.56,
   "text": "Oni de raan Ingan duoh oku, Jesus, Onak Topa de Ayuh Manah Kiasa?",
   "tempter": true
  },
  {
   "start": 20.16,
   "end": 21.14,
   "text": "Osi aden mu?",
   "tempter": false
  },
  {
   "start": 21.74,
   "end": 24.07,
   "text": "Aden koih Legion. Nya koih boge.",
   "tempter": true
  },
  {
   "start": 25.0,
   "end": 27.32,
   "text": "De tun pungu, ogi kaban oyuo tongah man.",
   "tempter": false
  },
  {
   "start": 27.52,
   "end": 29.23,
   "text": "Da koih moret kang oyuo de munu.",
   "tempter": true
  },
  {
   "start": 29.88,
   "end": 34.48,
   "text": "Jesus meh da eh. Oyuo de munu meh trajak bidasuor suo pungu, nuju ke laut.",
   "tempter": false
  },
  {
   "start": 35.68,
   "end": 40.34,
   "text": "Ayuo de kirin koyuh de munu, meh kruti ninga dari inuh, meh ideh di mun nya de nawa.",
   "tempter": false
  },
  {
   "start": 40.74,
   "end": 43.69,
   "text": "Nya munu meh toru. Bripotak da Jesus buu suo inuh.",
   "tempter": false
  },
  {
   "start": 44.19,
   "end": 45.78,
   "text": "Ja oku rie nuna Ingan.",
   "tempter": false
  },
  {
   "start": 46.17,
   "end": 50.85,
   "text": "Pari negeh ke bori mu. Tanen duoh nyaa oni koyuh de meh nai Topa suo mu.",
   "tempter": false
  },
  {
   "start": 51.75,
   "end": 54.78,
   "text": "Nuna koih suo part 8.",
   "tempter": false
  }
 ]
}