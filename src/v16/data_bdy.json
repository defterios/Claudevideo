 "lines": [
  {
   "start": 0.5,
   "end": 3.66,
   "text": "Jesus meh mori ke Nazareth, ju meh ngajar de synagogue.",
   "tempter": false
  },
  {
   "start": 4.06,
   "end": 8.61,
   "text": "Suo ki Yeh daped suo koyuh de in niti? Abah tukang koyuh sija? Onak Mary?",
   "tempter": false
  },
  {
   "start": 8.86,
   "end": 10.59,
   "text": "Nya danu meh dorie bisaya duoh Yeh.",
   "tempter": false
  },
  {
   "start": 10.99,
   "end": 15.87,
   "text": "Nabi neh kati kanih nya hormat eh, jek eh de topat dep eh sija nya doi hormat eh.",
   "tempter": false
  },
  {
   "start": 16.37,
   "end": 21.51,
   "text": "Jesus meh doi daped pikirien kiasa Eh danu. Boyo iran Eh ninga rayat danu doi bisaya duoh Yeh.",
   "tempter": false
  },
  {
   "start": 22.11,
   "end": 31.41,
   "text": "Jadi yeh meh pait rasol eh de 12 inuh, da nga duoh nga duoh. Ma toban oni-oni. Toban sikuud meh geh. Ngan pinguman. Ngan duit isah nya toban eh.",
   "tempter": false
  },
  {
   "start": 31.71,
   "end": 36.02,
   "text": "Nya munu meh ponu. Kasig muot kati kanih, ngubat nya da bait.",
   "tempter": false
  },
  {
   "start": 36.62,
   "end": 39.75,
   "text": "King Herod meh ngojit brita itih, ju yeh meh toru.",
   "tempter": false
  },
  {
   "start": 40.05,
   "end": 43.47,
   "text": "Joanis, nya de notek ku bak eh, meh mokat idip bauh!",
   "tempter": false
  },
  {
   "start": 43.98,
   "end": 50.44,
   "text": "Herod pronah gan Joanis de jier, sobab Joanis tanen nang: Porih ingan mit sowen sudi ingan neh.",
   "tempter": false
  },
  {
   "start": 50.94,
   "end": 57.66,
   "text": "Takar onu branak Herod, yeh mogan nya bruman. Onak dayung Herodias meh mokat bitana. Herod meh rami ninga eh.",
   "tempter": false
  },
  {
   "start": 57.96,
   "end": 62.02,
   "text": "Simun-mun koyuh de mitie mu ngin ku geh. Aropun stongah negri ku.",
   "tempter": false
  },
  {
   "start": 62.32,
   "end": 63.83,
   "text": "Oni de rie mitie ku yeh?",
   "tempter": false
  },
  {
   "start": 63.98,
   "end": 65.98,
   "text": "Oku ran bak Joanis Baptista.",
   "tempter": false
  },
  {
   "start": 66.86,
   "end": 72.63,
   "text": "Raja Herod meh susah otin. Tapi yeh dorie rie nurak pimitie dayung inuh sobap yeh meh bisupah dopan nya.",
   "tempter": false
  },
  {
   "start": 73.23,
   "end": 76.14,
   "text": "Ngaruom inuh, dowoh jier, meh ngorok eh tia.",
   "tempter": false
  },
  {
   "start": 77.34,
   "end": 80.79,
   "text": "Onak murit Joanis meh neg, mit gonan eh, ju meh ngubur.",
   "tempter": false
  },
  {
   "start": 81.59,
   "end": 84.89,
   "text": "Nuna koih suo part 10.",
   "tempter": false
  }
 ]
}