 "lines": [
  {
   "start": 0.5,
   "end": 6.51,
   "text": "Nyaa meh puan pasal Jesus. Sapai meh bogo nuna yeh kati kanih. Brobut rie toma Yeh.",
   "tempter": false
  },
  {
   "start": 6.81,
   "end": 10.82,
   "text": "Yeh meh da onak murit eh sidia orud, sa eh di pisiet da nyaa.",
   "tempter": false
  },
  {
   "start": 11.32,
   "end": 14.73,
   "text": "Nyaa de ogi muot de gonan eh sapai toru duoh ngrais.",
   "tempter": false
  },
  {
   "start": 14.93,
   "end": 17.29,
   "text": "Muu en eh Onak Topa!",
   "tempter": true
  },
  {
   "start": 18.2,
   "end": 22.71,
   "text": "Mokuo nuh yeh meh maad ke pungu, duoh mogan bara de rie da Eh nuna Dep eh.",
   "tempter": false
  },
  {
   "start": 23.31,
   "end": 29.82,
   "text": "Simon, Jesus praden yeh Peter. James duoh John, onak Zebedee, yaa de koda dudu. Andrew. Philip. Bartholomew.",
   "tempter": false
  },
  {
   "start": 30.07,
   "end": 35.08,
   "text": "Matthew. Thomas. James. Thaddeus. Simon.",
   "tempter": false
  },
  {
   "start": 35.43,
   "end": 39.14,
   "text": "Duoh Judas Iscariot. Nyaa de rie jua Jesus.",
   "tempter": false
  },
  {
   "start": 39.84,
   "end": 45.31,
   "text": "12 urang rasol eh. Rie da ponu magah Gah de Paguh, duoh kasig pibuu muot.",
   "tempter": false
  },
  {
   "start": 45.91,
   "end": 51.37,
   "text": "Takar madis ayuo eh meh puan, nya munu meh neg rie toban Jesus pari. Nya munu nang:",
   "tempter": false
  },
  {
   "start": 51.59,
   "end": 52.87,
   "text": "Yeh meh gira.",
   "tempter": false
  },
  {
   "start": 53.38,
   "end": 56.29,
   "text": "Yeh kasig muot pakai kuasa raja muot!",
   "tempter": false
  },
  {
   "start": 56.6,
   "end": 58.26,
   "text": "Jesus nang:",
   "tempter": false
  },
  {
   "start": 58.48,
   "end": 65.04,
   "text": "Watki Sitan kasig pibuu Sitan? Bori de doi bisamah otin eh, ideh di daped mujuog tuui.",
   "tempter": false
  },
  {
   "start": 66.11,
   "end": 72.42,
   "text": "Sino duoh sikie sudi Jesus meh neg, kajen de ruar ju meh sobut duoh nya da Jesus ruah.",
   "tempter": false
  },
  {
   "start": 72.82,
   "end": 74.02,
   "text": "Jesus meh in eh:",
   "tempter": false
  },
  {
   "start": 74.24,
   "end": 75.95,
   "text": "Osi sino duoh sikie sudi ku?",
   "tempter": false
  },
  {
   "start": 76.93,
   "end": 83.04,
   "text": "Osi de raan idip nuna de nang Topa, de munu leh sikie sudi ku, de munu leh sino ku.",
   "tempter": false
  }
 ]
}