 "lines": [
  {
   "start": 0.5,
   "end": 5.52,
   "text": "Bara Farisi meh kirin onak murid Jesus man pakai tongan de doi eh mamie bonar-bonar.",
   "tempter": false
  },
  {
   "start": 5.82,
   "end": 9.0,
   "text": "Oni onak murid mu pak doi nuna adat de pakai sumuk babai te?",
   "tempter": false
  },
  {
   "start": 9.4,
   "end": 13.96,
   "text": "Ingan posan sibaya Topa, ngan ingan nuna adat aturan de meh nai misia.",
   "tempter": false
  },
  {
   "start": 14.46,
   "end": 19.23,
   "text": "Ideh di koyuh de morot kang gonan nya de bikais odop nya. Pak eh koyuh daang otin nya.",
   "tempter": false
  },
  {
   "start": 19.93,
   "end": 25.91,
   "text": "Ju Jesus meh buu suo kanu odi kaang purou Tyrus. Rasu ogi dayung pubap odep eh de peen Jesus.",
   "tempter": false
  },
  {
   "start": 26.21,
   "end": 30.47,
   "text": "Mitie masi duoh ingan. Kodi muot dowoh gonan onak dayung ku.",
   "tempter": false
  },
  {
   "start": 30.86,
   "end": 37.57,
   "text": "Onak opet de patut nya ngin maan die neh. Doi nya patut mit pinguman suo yeh de munu ju meh ngin duoh kosuong.",
   "tempter": false
  },
  {
   "start": 38.07,
   "end": 43.31,
   "text": "Bonar Tuan. Pak eh kosuong de ribuo mija seen geh man pinguman de ruruh da onak opet.",
   "tempter": false
  },
  {
   "start": 43.91,
   "end": 49.3,
   "text": "Paguh saut muu neh, maad negeh. Muot inuh meh ruah suo gonan onak mu.",
   "tempter": false
  },
  {
   "start": 49.8,
   "end": 55.06,
   "text": "Yeh meh maad ke bori, ju meh daped onak eh guring de topat bees. Meh doi tia muot daang eh.",
   "tempter": false
  },
  {
   "start": 55.86,
   "end": 59.52,
   "text": "Mokuo inuh nyaa meh ogi toban dari de bibie bongam nudu Jesus.",
   "tempter": false
  },
  {
   "start": 59.92,
   "end": 66.42,
   "text": "Jesus meh toban yeh buu, mua juan eh suo nyaa de boge. Gan tongan Eh de kojit dari inuh, ju meh toma jora eh.",
   "tempter": false
  },
  {
   "start": 66.82,
   "end": 70.54,
   "text": "Yeh meh bigaeng ke rongit, narik napas, ju meh in eh:",
   "tempter": false
  },
  {
   "start": 71.04,
   "end": 73.24,
   "text": "Effata. Tibuka nih.",
   "tempter": false
  },
  {
   "start": 74.24,
   "end": 80.04,
   "text": "Danu geh yeh meh rasu ponai ngojit, jora eh meh ponai dodot. Ju yeh meh ponai sina torang-torang eh.",
   "tempter": false
  },
  {
   "start": 80.54,
   "end": 86.33,
   "text": "Tek-tek paguh koyuh de nai Nyaa itih neh. Nyaa de bongam ponai ngojit, nya de bibie ponai sina!",
   "tempter": false
  },
  {
   "start": 87.23,
   "end": 90.94,
   "text": "Nuna koih suo part 12.",
   "tempter": false
  }
 ]
}