 "lines": [
  {
   "start": 0.5,
   "end": 7.65,
   "text": "Meh boge nya tia rie ngojit Jesus. Ju yeh meh odi guru ke orud, ngajar nyaa suo kanu.",
   "tempter": false
  },
  {
   "start": 8.05,
   "end": 11.01,
   "text": "Ogi nyaa motak dabur ruang koyuh de rie puruh eh.",
   "tempter": false
  },
  {
   "start": 11.4,
   "end": 26.56,
   "text": "Ogi ruang de rabu dang oran, ju manuk meh neg man eh. Ogi de rabu de batuh, asa onu meh putiek yeh meh korong. Ogi geh de rabu de tana de boge koyuh de roja, ju meh obuoh kup meh doi ponai rie bibua.",
   "tempter": false
  },
  {
   "start": 27.05,
   "end": 35.36,
   "text": "Pak ogi geh de rabu de tana de buog-mamuo. Ju meh bibua. 30, 60, 100 sideh.",
   "tempter": false
  },
  {
   "start": 36.05,
   "end": 42.15,
   "text": "Pritah Topa itih koda ruang koyuh, ruang de sit geh, rie bibua jadi tongon de ayuh.",
   "tempter": false
  },
  {
   "start": 42.91,
   "end": 45.14,
   "text": "Singumi inuh Yeh meh nang:",
   "tempter": false
  },
  {
   "start": 45.36,
   "end": 47.32,
   "text": "Ja te motas ke pirad kanih.",
   "tempter": false
  },
  {
   "start": 47.81,
   "end": 52.02,
   "text": "Yeh me guring de punuok orud, ju meh bees.",
   "tempter": false
  },
  {
   "start": 52.82,
   "end": 57.65,
   "text": "Sobak ribut tia meh gogeh-gogeh neg. Ju piin grumang meh moret kang orud.",
   "tempter": false
  },
  {
   "start": 57.85,
   "end": 61.66,
   "text": "Mistar! Ideh keh ingan gaguo otte meh rie kuom?",
   "tempter": false
  },
  {
   "start": 62.15,
   "end": 65.79,
   "text": "Ngorek nya. Tono tia.",
   "tempter": false
  },
  {
   "start": 67.34,
   "end": 70.74,
   "text": "Sobak ribut meh roo. Ju raut meh tono.",
   "tempter": false
  },
  {
   "start": 71.54,
   "end": 75.3,
   "text": "Oni ingan pak skia toru? Aruo keh di ingan bisaya?",
   "tempter": false
  },
  {
   "start": 76.18,
   "end": 80.49,
   "text": "Onak murid eh meh sikubuon toru, ju meh in eh:",
   "tempter": false
  },
  {
   "start": 80.71,
   "end": 84.92,
   "text": "Osi-osi Nyaa itih? Sapai sobak ribut duoh grumang ngojit sina Eh.",
   "tempter": false
  },
  {
   "start": 85.83,
   "end": 91.6,
   "text": "Nuna koih suo part 7.",
   "tempter": false
  }
 ]
}