{
 "duration": 82.2,
 "lines": [
  {
   "n": 1,
   "scene": "carpenter",
   "bid": "Slama 30 sowa, yeh jek eh tukang koyuh. Doi nyaa piruh eh.",
   "en": "For thirty years, he was just a carpenter. Nobody noticed him.",
   "tempter": false,
   "start": 0.25,
   "end": 5.24
  },
  {
   "n": 2,
   "scene": "river",
   "bid": "Jadi daang 1 pagi, yeh meh muun ke sungi.",
   "en": "Then one morning, he stepped into a river.",
   "tempter": false,
   "start": 5.84,
   "end": 11.37
  },
  {
   "n": 3,
   "scene": "river",
   "bid": "Longit pun meh tibuka",
   "en": "And the sky tore open.",
   "tempter": false,
   "start": 11.79,
   "end": 13.13
  },
  {
   "n": 4,
   "scene": "river",
   "bid": "Ogi suara nang: Muu onak Ku, Oku nyayang muu.",
   "en": "A voice said: You are my Son. I love you.",
   "tempter": false,
   "start": 13.55,
   "end": 17.11
  },
  {
   "n": 5,
   "scene": "desert",
   "bid": "Mokuo de munu tia? Yeh meh toban dep eh ke padang pasir.",
   "en": "And right after that? He was driven into the desert.",
   "tempter": false,
   "start": 17.71,
   "end": 21.71
  },
  {
   "n": 6,
   "scene": "desert",
   "bid": "40 onu. Doi pinguman. Jek eh bonguh, batuh, duoh binatang buas.",
   "en": "Forty days. No food. Just heat, stone, and wild animals.",
   "tempter": false,
   "start": 22.13,
   "end": 28.21
  },
  {
   "n": 7,
   "scene": "whisper",
   "bid": "Mokuo inuh meh ogi suara nang.",
   "en": "Then came a whisper.",
   "tempter": false,
   "start": 28.81,
   "end": 31.02
  },
  {
   "n": 8,
   "scene": "bread",
   "bid": "Muu neh pirai, duok tukar batuh itih jadi ruti",
   "en": "You're starving. Turn this stone into bread.",
   "tempter": true,
   "start": 31.77,
   "end": 35.76
  },
  {
   "n": 9,
   "scene": "bread",
   "bid": "Yeh meh nang: Misia ideh di eh idip pakai pinguman sija.",
   "en": "He said: man does not live on bread alone.",
   "tempter": false,
   "start": 36.18,
   "end": 41.15
  },
  {
   "n": 10,
   "scene": "jump",
   "bid": "Bitabung. Pikirien mu onak Topa.",
   "en": "Jump. Prove who you are.",
   "tempter": true,
   "start": 41.9,
   "end": 44.62
  },
  {
   "n": 11,
   "scene": "jump",
   "bid": "Yeh nang in eh: Ma mu suba Topa.",
   "en": "He said: do not test God.",
   "tempter": false,
   "start": 45.04,
   "end": 48.09
  },
  {
   "n": 12,
   "scene": "bow",
   "bid": "Sujud tudu oku, tie suo de muti jadi tu dimu. Doi monam, doi salip.",
   "en": "Bow to me, and all of this is yours. No pain. No cross.",
   "tempter": true,
   "start": 48.84,
   "end": 55.38
  },
  {
   "n": 13,
   "scene": "bow",
   "bid": "Yeh de meh pirai, kowek, sadi eh ade.",
   "en": "He was starving. Shaking. Completely alone.",
   "tempter": false,
   "start": 55.8,
   "end": 58.78
  },
  {
   "n": 14,
   "scene": "bow",
   "bid": "Meh in eh: Buu",
   "en": "And he said: Go.",
   "tempter": false,
   "start": 59.2,
   "end": 61.0
  },
  {
   "n": 15,
   "scene": "angels",
   "bid": "Muot pun meh buu. Ju Malaikat meh neg.",
   "en": "The whisper left. And angels came.",
   "tempter": false,
   "start": 61.6,
   "end": 64.29
  },
  {
   "n": 16,
   "scene": "angels",
   "bid": "Jesus ruah suo padang pasir inuh romah, kowek tapi masih gogah mun pimonu eh.",
   "en": "He walked out of that desert thin, sunburnt, and unstoppable.",
   "tempter": false,
   "start": 64.71,
   "end": 70.25
  },
  {
   "n": 17,
   "scene": "kingdom",
   "bid": "Masa meh rie neg, Pritah Topa meh sinek.",
   "en": "The time has come. The kingdom of God is near.",
   "tempter": false,
   "start": 70.85,
   "end": 74.72
  },
  {
   "n": 18,
   "scene": "title",
   "bid": "Episod 1: Padang Pasir. Follow suo part 2.",
   "en": "Episode one: The Wilderness. Follow for part two.",
   "tempter": false,
   "start": 75.32,
   "end": 80.0
  }
 ],
