 "lines": [
  {
   "start": 0.5,
   "end": 5.38,
   "text": "Takar de romin Topa, bara Farisi suba rie sikien koyuh duoh Jesus ngan eh rie ngijorat Eh.",
   "tempter": false
  },
  {
   "start": 5.68,
   "end": 8.28,
   "text": "Mistar, patut keh ideh nya bayar sukie nudu Caesar?",
   "tempter": false
  },
  {
   "start": 8.55,
   "end": 11.98,
   "text": "Toban duit siring kati. Gamar osi itih? Aden osi itih?",
   "tempter": false
  },
  {
   "start": 12.38,
   "end": 13.03,
   "text": "Caesar.",
   "tempter": false
  },
  {
   "start": 13.28,
   "end": 17.47,
   "text": "Ju koyuh de kaku Caesar ngin duoh Caesar, koyuh de kaku Topa ngin duoh Topa.",
   "tempter": false
  },
  {
   "start": 18.17,
   "end": 22.63,
   "text": "Mokuo inuh ogi ade guru adat sikien Yeh: Suo suo sibaya, munki sibaya de kason ayuh?",
   "tempter": false
  },
  {
   "start": 23.03,
   "end": 29.85,
   "text": "Nyomah Topa nikan de bonar, ngan sipunuo otin ingan, sipunuo asong, suo pikir kira, suo pikuat ingan.",
   "tempter": false
  },
  {
   "start": 30.35,
   "end": 36.63,
   "text": "De nomor 2 eh neh itih: Nyayang nyaa nyam nya nyayang odop nya. Doi sibaya de boken de robih ayuh suo sibaya de 2 itih.",
   "tempter": false
  },
  {
   "start": 37.33,
   "end": 43.41,
   "text": "Jesus meh guru sinek kutak suo nya gan sdokah, Yeh meh ninga. Boge nyaa de kaya suod mua kiang duit eh.",
   "tempter": false
  },
  {
   "start": 43.71,
   "end": 47.91,
   "text": "Ju meh neg reh dayung sutuok de kobes bonen eh, suod 2 kiping siring tibaga.",
   "tempter": false
  },
  {
   "start": 48.51,
   "end": 58.07,
   "text": "Oku tanen de ingan tek-tek eh dep eh neh, dayung de meh doi bonen eh itih meh gan robis suo nyaa de boken. Ingan de boken ngin duit de meh todeh eh sija, pak eh yeh ngin suo duit de ogi de dep eh.",
   "tempter": false
  },
  {
   "start": 58.87,
   "end": 62.57,
   "text": "Takar nya munu meh buu suo romin Topa inuh, ni urang onak murid Eh meh in eh:",
   "tempter": false
  },
  {
   "start": 62.77,
   "end": 67.03,
   "text": "Mistar, duok ninga! Mun kona romin de munu! Mun jongon batuh sinung eh!",
   "tempter": false
  },
  {
   "start": 67.33,
   "end": 72.76,
   "text": "Ni onu tie ni kruang batuh doo geh rie supieh rokat de dingan eh. Suo eh rie posik porai geh.",
   "tempter": false
  },
  {
   "start": 73.36,
   "end": 78.14,
   "text": "Rongit duoh tana ponai rie patuob, pak eh sina Oku doi akan ponai tikodi.",
   "tempter": false
  },
  {
   "start": 78.74,
   "end": 82.58,
   "text": "Jaga-jaga nya. Doi nyaa de puan sinie Onu Pingituong rie neg.",
   "tempter": false
  },
  {
   "start": 83.48,
   "end": 86.95,
   "text": "Nuna koih suo part 17.",
   "tempter": false
  }
 ]
}