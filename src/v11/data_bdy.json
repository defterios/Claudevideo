 "lines": [
  {
   "start": 3.2,
   "end": 7.35,
   "text": "Dang onu Sabbath, Jesus biayuo de onak murid eh ponu nuna tota gondom.",
   "tempter": false
  },
  {
   "start": 8.95,
   "end": 10.96,
   "text": "Ninga. Nya munu bitupas de gondom.",
   "tempter": false
  },
  {
   "start": 11.86,
   "end": 15.62,
   "text": "Topa nai Sabbath suo misia. Ideh nai misia suo Sabbath.",
   "tempter": false
  },
  {
   "start": 17.22,
   "end": 21.4,
   "text": "Sodang tian ade de synagogue, tonga ni dari noman tongan eh de nawa.",
   "tempter": false
  },
  {
   "start": 22.4,
   "end": 27.03,
   "text": "Bara Farisi prati Jesus. Rie kajen yeh doi nuna pritah onu Sabbath.",
   "tempter": false
  },
  {
   "start": 28.23,
   "end": 30.44,
   "text": "Mokat nya. Get ke tongah itih.",
   "tempter": false
  },
  {
   "start": 31.44,
   "end": 38.36,
   "text": "Patut keh ideh dang onu Sabbath otte nai koyuh de paguh, atau koyuh de jaat? Te ngramat nyawa, ato katod eh?",
   "tempter": false
  },
  {
   "start": 38.96,
   "end": 40.01,
   "text": "Suo nya meh ngorek.",
   "tempter": false
  },
  {
   "start": 41.61,
   "end": 42.81,
   "text": "Nongon tongan mu.",
   "tempter": false
  },
  {
   "start": 44.61,
   "end": 45.46,
   "text": "Tongan eh meh bait.",
   "tempter": false
  },
  {
   "start": 48.16,
   "end": 50.97,
   "text": "Ngaruom inuh, bala Farisi meh bipokat dupan dep eh.",
   "tempter": false
  },
  {
   "start": 51.57,
   "end": 53.85,
   "text": "Yeh inuh mesti rie kobes.",
   "tempter": true
  }
 ]
}